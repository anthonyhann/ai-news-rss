# LLM: any OpenAI-compatible endpoint. No vendor is hard-coded.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_SCORING_MODEL=deepseek-chat
LLM_EDITOR_MODEL=deepseek-chat

# GitHub API (optional but recommended; raises the rate limit)
GITHUB_TOKEN=

# X / Twitter browser collector
# Create an X List containing your AI builders, then paste its URL:
# You may also use https://x.com/home to collect the authenticated home timeline.
X_LIST_URL=https://x.com/i/lists/0000000000000000000
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
TWITTER_PROXY=
# Use the local logged-in ego-lite browser instead of Playwright:
EGO_BROWSER_ENABLED=0
# Optional: prefer a locally installed Chrome channel; unset for bundled Chromium.
PLAYWRIGHT_CHANNEL=

# WeChat Official Account RSS bridge (wechat2rss / WeRSS / self-hosted)
WECHAT_RSS_BASE=

# Push channels
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_PASSWORD=

# Public web address used by notification cards and email links
PUBLIC_SITE_URL=https://anthonyhann.github.io/ai-news-rss

# Local server
ADMIN_TOKEN=

# Degraded mode: allow collection without an LLM (mock scoring)
ALLOW_DEGRADED=false
